# Ambiente
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/launchpad"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# Blockchain - Lunes Network
LUNES_RPC_URL="wss://rpc.lunes.io"
LUNES_HTTP_URL="https://rpc.lunes.io"
CONTRACT_ADDRESS="0x..."
PRIVATE_KEY="0x..."
MNEMONIC="your twelve word mnemonic phrase here for development only"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="noreply@launchpad.lunes.io"
FROM_NAME="Lunes Launchpad"

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_BUCKET_NAME="launchpad-files"
AWS_REGION="us-east-1"

# External APIs
KYC_API_KEY="your-kyc-provider-key"
KYC_API_URL="https://api.kyc-provider.com"
PRICE_ORACLE_API="your-price-api-key"
PRICE_ORACLE_URL="https://api.coingecko.com/api/v3"

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Monitoring
LOG_LEVEL="info"
ENABLE_SWAGGER=true
ENABLE_METRICS=true

# Queue Configuration
QUEUE_REDIS_URL="redis://localhost:6379"
QUEUE_CONCURRENCY=5

# Blockchain Monitoring
BLOCK_CONFIRMATION_COUNT=3
EVENT_SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MS=5000

# AMA Configuration
AMA_DEFAULT_PRICE_USD=200
AMA_LUNES_QUESTION_COST=0.5
AMA_LUNES_VOTE_COST=0.5

# Platform Fees
PLATFORM_FEE_PERCENT=2.5
LISTING_FEE_LUNES=1000
STAKING_REWARD_RATE=0.12